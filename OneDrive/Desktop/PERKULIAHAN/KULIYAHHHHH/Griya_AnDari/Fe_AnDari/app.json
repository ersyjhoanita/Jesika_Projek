{
  "expo": {
    "name": "Griya AnDari",
    "slug": "Griya AnDari",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-griya-andari.png",
    "scheme": "feandari",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo-griya-andari.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/logo-griya-andari.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/logo-griya-andari.png",
          "imageWidth": 250
        }
      ],
      "expo-font",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
