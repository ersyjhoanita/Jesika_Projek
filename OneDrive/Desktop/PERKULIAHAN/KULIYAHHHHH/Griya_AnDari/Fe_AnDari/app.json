{
  "expo": {
    "name": "Griya AnDari",
    "slug": "griya-andari",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-griya-andari.png",
    "scheme": "feandari",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo-griya-andari.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/logo-griya-andari.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ersy8731.griyaandari"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/logo-griya-andari.png",
          "imageWidth": 250
        }
      ],
      "expo-font",
      "expo-dev-client"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8e95e250-b3e9-41fc-a6ae-ac623b758175"
      }
    }
  }
}
